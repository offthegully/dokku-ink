{
  "name": "dokku-ink",
  "version": "0.1.6",
  "description": "A terminal dashboard & command center for Dokku. See all your apps and run any dokku command, on the host or over SSH.",
  "type": "module",
  "bin": {
    "dokku-ink": "dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/offthegully/dokku-ink.git"
  },
  "homepage": "https://github.com/offthegully/dokku-ink#readme",
  "bugs": {
    "url": "https://github.com/offthegully/dokku-ink/issues"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "prepublishOnly": "npm run build",
    "build:binary": "bun scripts/build.ts",
    "build:binaries": "bun scripts/build-all.ts",
    "dev": "tsx src/index.tsx",
    "demo": "tsx src/index.tsx --demo",
    "dev:bun": "bun src/index.tsx",
    "demo:bun": "bun src/index.tsx --demo",
    "start": "node dist/index.js",
    "start:bun": "bun dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "dokku",
    "dashboard",
    "tui",
    "ink",
    "terminal",
    "typescript",
    "paas"
  ],
  "license": "MIT",
  "dependencies": {
    "ink": "^5.2.1",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.31",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
